# =============================================================
#  Auto Import CRM — пример конфигурации
#  Скопируйте в .env и замените все значения-заглушки.
#  Файл .env в репозиторий не попадает (см. .gitignore).
# =============================================================

# --- Окружение ---
APP_ENV=development           # development | staging | production
APP_NAME="Auto Import CRM"
# COOKIE_SECURE=false   # на HTTP без TLS; при https:// в APP_PUBLIC_URL можно не задавать
# Прод с TLS: APP_PUBLIC_URL=https://гоуимпорт.рф  (и CORS/STORAGE ниже на https)
APP_PUBLIC_URL=http://localhost:5173
LOG_LEVEL=debug               # debug | info | warn | error
LOG_FORMAT=text               # text | json (в production обязательно json)

# --- HTTP-сервер Go ---
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Доверенные прокси-сети, из которых разрешено читать X-Forwarded-For.
# Пусто = реальный IP всегда берётся из TCP-соединения (безопасный дефолт).
TRUSTED_PROXY_CIDRS=172.16.0.0/12,127.0.0.1/32
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=autoimport
POSTGRES_USER=autoimport_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Роль для миграций. Владеет схемой и имеет права на DDL.
# Роль приложения выше DDL-прав НЕ имеет — это осознанное разделение.
POSTGRES_MIGRATOR_USER=autoimport_migrator
POSTGRES_MIGRATOR_PASSWORD=CHANGE_ME_MIGRATOR_PASSWORD
POSTGRES_SSLMODE=disable      # в production: require или verify-full
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_STATEMENT_TIMEOUT=15s

# Для go test ./internal/store — та же база, что и API. Если пусто, тест
# собирает DSN из POSTGRES_*. Нет соединения — t.Skip, CI не падает.
TEST_DATABASE_URL=


# --- Redis (сессии, rate-limit, кеш, счётчики баннеров) ---
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# --- Криптография и токены ---
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_LONG_RANDOM_SECRET
JWT_ISSUER=autoimport-crm
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Ключ шифрования персональных данных (AES-256-GCM), ровно 32 байта в base64
PII_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES_KEY

# --- Параметры argon2id ---
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# --- Rate limit и анти-DDoS ---
RATELIMIT_ENABLED=true
RATELIMIT_GLOBAL_PER_MINUTE=600
RATELIMIT_LOGIN_PER_MINUTE=5
RATELIMIT_REGISTER_PER_HOUR=3
RATELIMIT_VERIFY_CODE_PER_10MIN=3
RATELIMIT_SEARCH_PER_MINUTE=60
RATELIMIT_UPLOAD_PER_HOUR=20
AUTOBAN_ENABLED=true
AUTOBAN_SUSPICIOUS_THRESHOLD=25
AUTOBAN_WINDOW=5m
AUTOBAN_BASE_DURATION=5m
AUTOBAN_MAX_DURATION=24h

# --- Ограничения размеров запросов ---
MAX_REQUEST_BODY_BYTES=131072      # 128 KiB для JSON
MAX_UPLOAD_BYTES=12582912          # 12 MiB для фото
MAX_UPLOAD_IMAGE_PIXELS=40000000   # защита от decompression bomb

# --- Хранилище файлов ---
STORAGE_DRIVER=local               # local | s3
# Локально: ./storage/uploads
# Docker full: путь переопределяется в compose на /app/storage/uploads
STORAGE_LOCAL_PATH=./storage/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/uploads

# --- Почта (в docker full: SMTP_HOST/PORT из .env, иначе mailpit) ---
# Яндекс: smtp.yandex.ru:587 + пароль приложения
# Gmail:  smtp.gmail.com:587 + app password
# Mail.ru: smtp.mail.ru:587 + пароль приложения (не обычный пароль ящика)
# From должен совпадать с ящиком SMTP_USER, иначе Mail.ru отклонит письмо.
MAILER_DRIVER=smtp                 # log | smtp
SMTP_HOST=smtp.mail.ru
SMTP_PORT=587
SMTP_USER=goimport@mail.ru
SMTP_PASSWORD=
SMTP_FROM="GoImport CRM <goimport@mail.ru>"

# --- SMS ---
SMS_DRIVER=log                     # log | smsc | twilio
SMS_API_KEY=
SMS_SENDER=AUTOIMPORT

# --- Captcha (после серии неудачных попыток входа) ---
CAPTCHA_DRIVER=disabled            # disabled | turnstile | hcaptcha
CAPTCHA_SECRET=
CAPTCHA_SITE_KEY=

# --- Социальные сети (разовые приложения площадки, не ключи дилера) ---
# Без Meta/Google кнопки Instagram и YouTube в кабинете дилера серые.
VK_APP_ID=
VK_APP_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Куда Meta/Google вернут код. По умолчанию {APP_PUBLIC_URL}/api/v1/integrations/oauth/callback
OAUTH_REDIRECT_URI=

# --- Docker Compose (только для docker-compose.yml) ---
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD
# Локально full: 8081/8443. На VPS: 80 и 443.
NGINX_HTTP_PORT=8081
NGINX_HTTPS_PORT=8443
# Let's Encrypt (deploy/enable-https.sh). Домен строго в punycode: .рф = xn--p1ai
TLS_DOMAIN=xn--c1akmgcfiqd.xn--p1ai
# Реальный email (не example.com) — иначе ACME откажет регистрацию
CERTBOT_EMAIL=
MAILPIT_UI_PORT=8025
