# Настройки под нестабильный канал.
#
# Соединение с реестром регулярно обрывается на крупных пакетах, поэтому
# повторов больше, чем по умолчанию, а таймаут выше: иначе установка падает
# на середине и начинается заново вместо продолжения.
fetch-retries=10
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=600000

# Точные версии в package.json: диапазон ^ означает, что сборка на другой машине
# может получить другой набор пакетов, а это худший вид невоспроизводимости.
save-exact=true

audit=false
fund=false
